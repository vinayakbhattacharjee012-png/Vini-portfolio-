# Required to run the bot (never commit real values)
DISCORD_TOKEN=
CLIENT_ID=
# Optional: register commands to one guild instantly (dev) instead of globally
DEV_GUILD_ID=
# Where the JSON store lives (default ./data)
DATA_DIR=./data

# Optional AI backend (any OpenAI-compatible /chat/completions endpoint). Unset => explicit setup notice.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional audio: requires `npm i @discordjs/voice` + a stream resolver service. Unset => honest status notice.
AUDIO_STREAM_URL=
